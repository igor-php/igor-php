APP_NAME="Igor Leak Lab"
APP_ENV=local
# Demo-only key: never reuse it outside this laboratory
APP_KEY=base64:aWdvci1sYXJhdmVsLWxlYWstbGFiLWRlbW8ta2V5ISE=
APP_DEBUG=true
APP_URL=http://localhost:8090

LOG_CHANNEL=stderr
