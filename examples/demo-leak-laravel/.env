CACHE_STORE=array
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite

OCTANE_SERVER=frankenphp

# Runtime mode shown in the page banner (overridden per service in docker-compose.yaml)
IGOR_RUNTIME_MODE=unknown
