{
    "name": "igor-php/igor-php",
    "description": "The faithful assistant for your FrankenPHP Workers: finds the state that leaks between requests in Symfony and Laravel Octane apps, from the CLI, PhpStorm, Claude Code or any MCP client.",
    "keywords": ["frankenphp", "linter", "static-analysis", "symfony", "laravel", "octane", "worker", "memory-leak", "mcp"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin MARTINS",
            "email": "kevin.martins@me.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "bin": [
        "bin/igor-php"
    ],
    "autoload": {
        "psr-4": {
            "IgorPhp\\IgorBundle\\": "src/php/",
            "IgorPhp\\Laravel\\": "src/laravel/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IgorPhp\\Laravel\\IgorServiceProvider"
            ]
        }
    }
}
